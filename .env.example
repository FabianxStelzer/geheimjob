DATABASE_URL="file:./dev.db"
AUTH_SECRET="generiere-mit-openssl-rand-base64-32"
AUTH_URL="https://app.geheimjob.de"
# Produktion: https://app.geheimjob.de (die Next.js-App, nicht die Marketing-Domain)
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional für lokale Entwicklung)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
